# Copy this file to .env and adjust the values before running docker compose.
# Never commit the real .env file.

#######################################################
## GENERAL ############################################
#######################################################
GENERAL_DATA_EMAIL=you@example.com
GENERAL_DATA_OPENAI_KEY=sk-replace-me
GENERAL_DATA_OPENAI_MODEL=gpt-4o-mini

#######################################################
## API AND DASHBOARD ##################################
#######################################################
API_HOST=homeapi
API_PORT=3001
DASHBOARD_HOST=home-dashboard
DASHBOARD_PORT=8081

#######################################################
## N8N ################################################
#######################################################
N8N_PORT=5678
N8N_PUBLIC_PORT=5678
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change-me
N8N_HOST=task.example.com
N8N_PROTOCOL=https
N8N_WEBHOOK_URL=https://task.example.com
N8N_GENERIC_TIMEZONE=Europe/Vienna
N8N_POSTGRESDB_USER=n8n
N8N_POSTGRESDB_PASSWORD=change-me

#######################################################
## FIREFLY III ########################################
#######################################################
FIREFLY_HOST=firefly
FIREFLY_IMPORTER_HOST=firefly-importer
FIREFLY_PORT=8082
FIREFLY_IMPORTER_PORT=8083

#######################################################
## DATABASES ##########################################
#######################################################
POSTGRES_DB_HOST=dbhome
POSTGRES_PORT=5432
# This name has to match the admin role that dbhome/init grants privileges to.
POSTGRES_ADMIN_USER=admin
POSTGRES_ADMIN_PASSWORD=change-me
REDIS_HOST=redis
REDIS_PORT=6379

#######################################################
## PAPERLESS ##########################################
#######################################################
PAPERLESS_HOST=paperless
PAPERLESS_URL=https://paperless.example.com
PAPERLESS_PORT=3000
PAPERLESS_TIMEZONE=Europe/Vienna
PAPERLESS_OCR_LANGUAGE=eng
PAPERLESS_OCR_LANGUAGES=eng deu slv
PAPERLESS_REDIS_PREFIX=paperless
PAPERLESS_CONSUMER_RECURSIVE=1
PAPERLESS_CONSUMER_SUBDIRS_AS_TAGS=true
PAPERLESS_CONSUMER_POLLING=2
PAPERLESS_SECRET_KEY=change-me-to-a-long-random-string

#######################################################
## HOST PATHS #########################################
#######################################################
# Absolute host path that paperless-ngx watches for new scans.
SCANFOLDER=D:/Home/SCANS
# Absolute host path used for the paperless export / 7z backups.
BACKUPFOLDER=D:/Home/BACKUPS

#######################################################
## MEALIE #############################################
#######################################################
MEALIE_PORT=9005
MEALIE_BASE_URL=https://recipes.example.com
MEALIE_POSTGRES_USER=mealie
MEALIE_POSTGRES_PASSWORD=change-me
MEALIE_POSTGRES_DB=mealie
MEALIE_MAIL_PASSWORD=change-me

#######################################################
## GROCY ##############################################
#######################################################
GROCY_PORT=9283

#######################################################
## OTHER SERVICES #####################################
#######################################################
GOTENBERG_PORT=3005
