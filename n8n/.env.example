# Copy this file to .env. It is loaded by the n8n container (env_file in docker-compose.yml)
# and is also available inside n8n Function nodes via $env.

# Google Drive / Sheets ids used by the archiving workflows
SPREADSHEET_ID=replace-with-your-spreadsheet-id
DRIVE_FOLDER_ID=replace-with-your-drive-folder-id

# LLM providers used by the workflow nodes
ANTHROPIC_API_KEY=sk-ant-replace-me
OPENAI_API_KEY=sk-replace-me
DEEPSEEK_API_KEY=sk-replace-me

# Where workflow notifications are sent
NOTIFICATION_EMAIL=you@example.com

# Reachable from inside the docker network
GOTENBERG_URL=http://gotenberg:3000